# Required for live embeddings and answers. Tests do not need a key.
OPENAI_API_KEY=

# Optional. Defaults shown below are used when a value is empty or unset.
PORT=4000
NODE_ENV=development
DATABASE_PATH=./data/knowledge.db
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chunk size and overlap are approximate tokens (4 characters per token).
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.25
MAX_CHUNKS_PER_ITEM=3

# Outbound page fetches
MAX_URL_BYTES=2000000
REQUEST_TIMEOUT_MS=10000

# Browser origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:5173
